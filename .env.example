OPENWEATHERMAP_API_KEY=<your_openweathermap_api_key>

GROQ_API_KEY=<your_groq_api_key>
HUGGINGFACE_API_KEY=<your_huggingface_api_key>

NEXT_PUBLIC_GEONAMES_USER=<your_geonames_username>

NEXT_PUBLIC_FIREBASE_API_KEY=<your_firebase_api_key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<your_project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<your_project_id>
NEXT_PUBLIC_FIREBASE_APP_ID=<your_firebase_app_id>

# AI Model Configuration
PRIMARY_MODEL_PROVIDER=groq
PRIMARY_MODEL_ID=llama-3.1-8b-instant
PRIMARY_MODEL_NAME=Groq (llama-3.1-8b-instant)

FALLBACK_MODEL_PROVIDER=huggingface
FALLBACK_MODEL_ID=openai/gpt-oss-120b
FALLBACK_MODEL_NAME=Hugging Face (GPT-OSS-120B)

# STT Model Configuration
NEXT_PUBLIC_STT_MODEL_ID=openai/whisper-large-v3
NEXT_PUBLIC_STT_MODEL_NAME=Whisper Large V3 (Multilingual)
